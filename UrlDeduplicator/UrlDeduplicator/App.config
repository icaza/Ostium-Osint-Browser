<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <runtime>
    <!-- Workstation GC keeps the memory footprint small; concurrent GC avoids
         long pauses while the file is being streamed. This favors low resource
         usage over raw multi-core throughput, per the app's design goal. -->
    <gcServer enabled="false" />
    <gcConcurrent enabled="true" />
  </runtime>
</configuration>
