<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- On cible .NET 9 ou 10 selon le SDK installé sur votre machine -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>StylometryAnonymizer</RootNamespace>
    <AssemblyName>StylometryAnonymizer</AssemblyName>
    
    <!-- Activation de Windows Forms sur le SDK moderne -->
    <UseWindowsForms>true</UseWindowsForms>
    
    <StartupObject>StylometryAnonymizer.Program</StartupObject>
    <ApplicationIcon>Anonymous.ico</ApplicationIcon>
    
    <!-- Gestion des ressources complexes non-chaînes -->
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>

    <Version>1.0.3</Version>
    <AssemblyVersion>1.0.3.0</AssemblyVersion>
    <FileVersion>1.0.3.0</FileVersion>
    <Authors>ICAZA</Authors>
    <Company>ICAZA MEDIA</Company>
    <Product>Stylometry Anonymizer</Product>
    <Description>Outil d'anonymisation stylométrique.</Description>
    <Copyright>MIT</Copyright>    

    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>    

    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>    
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Les références systèmes standard (System, Drawing, etc.) sont gérées automatiquement par Sdk="Microsoft.NET.Sdk" -->
    <!-- On déclare uniquement le package NuGet Newtonsoft.Json mis à jour pour .NET moderne -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Collections.Immutable" Version="11.0.0" />
    <PackageReference Include="System.Formats.Nrbf" Version="11.0.0" />
    <PackageReference Include="System.Resources.Extensions" Version="11.0.0" GeneratePathProperty="true" />
  </ItemGroup>

  <!-- Inclusion forcée de la DLL pour le mode SingleFile -->
  <ItemGroup>
    <Reference Include="System.Resources.Extensions">
      <HintPath>$(PkgSystem_Resources_Extensions)\lib\netstandard2.0\System.Resources.Extensions.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
